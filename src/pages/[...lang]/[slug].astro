---
/**
 * Renders every top-level static page (about, projects, now, contact, cv, blog index
 * placeholder) from one route map, delegating the body to a page component.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import About from '@/components/pages/About.astro';
import Contact from '@/components/pages/Contact.astro';
import Cv from '@/components/pages/Cv.astro';
import Now from '@/components/pages/Now.astro';
import Privacy from '@/components/pages/Privacy.astro';
import Projects from '@/components/pages/Projects.astro';
import type { Locale } from '@/i18n/config';
import { ROUTES, STATIC_PAGES, routeFromSlug, type RouteId } from '@/i18n/routes';
import { alternates, localeStaticPaths, t } from '@/i18n/utils';

export const getStaticPaths = () =>
  localeStaticPaths((locale) => STATIC_PAGES.map((route) => ({ slug: ROUTES[route][locale] })));

const { locale } = Astro.props as { locale: Locale };
const route = routeFromSlug(locale, Astro.params.slug);
if (!route) throw new Error(`No route for slug "${Astro.params.slug}" in locale "${locale}"`);
const tr = t(locale);
const title = tr(`page.${route}.title` as const);
const description = route === 'privacy' ? tr('page.privacy.description') : tr('site.description');

const bodies: Partial<Record<RouteId, typeof About>> = { about: About, now: Now, projects: Projects, contact: Contact, cv: Cv, privacy: Privacy };
const Body = bodies[route];
---

<BaseLayout locale={locale} route={route} title={title} description={description} alternates={alternates(route)}>
  <article class="page">
    <h1>{title}</h1>
    {Body ? <Body locale={locale} /> : <p class="page__placeholder">{tr('page.placeholder')}</p>}
  </article>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
  }
  .page__placeholder {
    color: var(--color-muted);
  }
</style>
