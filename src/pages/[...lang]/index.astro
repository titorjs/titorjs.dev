---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { alternates, localePath, localeStaticPaths, t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props as { locale: Locale };
const tr = t(locale);
---

<BaseLayout
  locale={locale}
  route="home"
  title={tr('site.title')}
  description={tr('site.description')}
  alternates={alternates('home')}
>
  <section class="hero">
    <p class="label label--accent">{tr('site.location')}</p>
    <h1 class="hero__name"><span class="hero__prefix" aria-hidden="true">// </span>Tito Jaramillo</h1>
    <p class="hero__tagline">{tr('site.tagline')}</p>
    <p class="hero__intro">{tr('site.intro')}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={localePath(locale, 'projects')}>{tr('home.cta.projects')}</a>
      <a class="button" href={localePath(locale, 'contact')}>{tr('home.cta.contact')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-12);
  }
  .hero__prefix {
    color: var(--color-accent);
    font-weight: 400;
  }
  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 44ch;
  }
  .hero__intro {
    max-width: var(--measure);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
