---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { alternates, localePath, localeStaticPaths, localeTag, t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props as { locale: Locale };
const tr = t(locale);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const now = await getEntry('pages', `now.${locale}`);
const nowItems = (now?.body ?? '')
  .split('\n')
  .filter((line) => line.startsWith('- '))
  .slice(0, 3)
  .map((line) => line.slice(2));
const nowUpdated = now?.data.updated;
const nowUpdatedLabel =
  nowUpdated && new Intl.DateTimeFormat(localeTag(locale), { month: 'long', year: 'numeric' }).format(nowUpdated);
---

<BaseLayout
  locale={locale}
  route="home"
  title={tr('site.title')}
  description={tr('site.description')}
  alternates={alternates('home')}
>
  <section class="hero">
    <p class="label label--accent">{tr('site.location')}</p>
    <h1 class="hero__name"><span class="hero__prefix" aria-hidden="true">// </span>Tito Jaramillo</h1>
    <p class="hero__tagline">{tr('site.tagline')}</p>
    <p class="hero__intro">{tr('site.intro')}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={localePath(locale, 'projects')}>{tr('home.cta.projects')}</a>
      <a class="button" href={localePath(locale, 'contact')}>{tr('home.cta.contact')}</a>
    </div>
  </section>

  <section class="block" aria-labelledby="home-projects">
    <h2 id="home-projects" class="label block__title">{tr('home.projects.title')}</h2>
    <ul class="featured">
      {
        projects.map(({ data }) => (
          <li class="featured__item">
            <p class="label">{data.meta[locale]}</p>
            <h3 class="featured__title">{data.url ? <a href={data.url}>{data.title[locale]}</a> : data.title[locale]}</h3>
            <p class="featured__summary">{data.summary[locale]}</p>
          </li>
        ))
      }
    </ul>
    <a class="block__more" href={localePath(locale, 'projects')}>{tr('home.projects.all')} →</a>
  </section>

  {
    nowItems.length > 0 && (
      <section class="block" aria-labelledby="home-now">
        <h2 id="home-now" class="label block__title">
          {tr('home.now.title')}{' '}
          {nowUpdatedLabel && (
            <span class="block__date">
              · <time datetime={nowUpdated!.toISOString().slice(0, 10)}>{nowUpdatedLabel}</time>
            </span>
          )}
        </h2>
        <ul class="now">
          {nowItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a class="block__more" href={localePath(locale, 'now')}>{tr('home.now.all')} →</a>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-8);
  }
  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-4) var(--space-12);
    }
  }
  .hero__prefix {
    color: var(--color-accent);
    font-weight: 400;
  }
  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 44ch;
  }
  .hero__intro {
    max-width: var(--measure);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .block {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }
  .block:last-of-type {
    padding-bottom: 0;
  }
  @media (min-width: 48rem) {
    .block {
      padding-block: var(--space-8);
    }
  }
  .block__title {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }
  .block__date {
    color: var(--color-muted);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }
  .block__more {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .featured {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 48rem) {
    .featured {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }
  .featured__item {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .featured__title {
    font-size: var(--text-lg);
  }
  .featured__title a {
    color: inherit;
  }
  .featured__summary {
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .now {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
</style>
