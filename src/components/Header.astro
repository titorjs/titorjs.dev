---
import type { Locale } from '@/i18n/config';
import { NAV_ORDER, type RouteId } from '@/i18n/routes';
import { localePath, t } from '@/i18n/utils';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  current: RouteId;
  alternates: { locale: Locale; path: string }[];
}
const { locale, current, alternates } = Astro.props;
const tr = t(locale);
const items = NAV_ORDER.filter((id) => id !== 'home');
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={localePath(locale, 'home')} aria-label={tr('nav.home')}>
      titorjs<span class="brand__tld">.dev</span>
    </a>

    <nav class="nav" aria-label={tr('nav.menu')}>
      <ul class="nav__list">
        {items.map((id) => (
          <li>
            <a
              href={localePath(locale, id)}
              aria-current={current === id ? 'page' : undefined}
              class:list={['nav__link', { 'nav__link--current': current === id }]}
            >
              {tr(`nav.${id}` as const)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__tools">
      <LanguageSwitch locale={locale} alternates={alternates} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-rule);
  }
  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-3);
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .brand:hover { text-decoration: none; }
  .brand__tld { color: var(--color-muted); font-weight: 400; }

  .nav { order: 3; flex-basis: 100%; }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .nav__link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    padding-block: var(--space-1);
  }
  .nav__link:hover { color: var(--color-text); text-decoration: none; }
  .nav__link--current {
    color: var(--color-text);
    box-shadow: inset 0 -1px 0 var(--color-accent);
  }

  .header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 48rem) {
    .nav { order: 0; flex-basis: auto; }
    .nav__list { gap: var(--space-6); }
  }
</style>
