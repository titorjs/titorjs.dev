---
import { LOCALES, LOCALE_LABELS, type Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  alternates: { locale: Locale; path: string }[];
}
const { locale, alternates } = Astro.props;
const tr = t(locale);
---

<nav class="lang" aria-label={tr('lang.switch')}>
  {LOCALES.map((l) => {
    const target = alternates.find((a) => a.locale === l);
    const current = l === locale;
    return (
      <a
        href={target?.path ?? `/${l === 'es' ? '' : l}`}
        hreflang={l}
        lang={l}
        aria-current={current ? 'page' : undefined}
        class:list={['lang__item', { 'lang__item--current': current }]}
        title={LOCALE_LABELS[l]}
      >
        {l.toUpperCase()}
      </a>
    );
  })}
</nav>

<style>
  .lang {
    display: flex;
    gap: var(--space-1);
  }
  .lang__item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-rule);
    color: var(--color-muted);
  }
  .lang__item:hover {
    text-decoration: none;
    color: var(--color-text);
  }
  .lang__item--current {
    color: var(--color-text);
    border-color: var(--color-text);
  }
</style>
