---
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import { SOCIAL } from '@/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <span>© {year} {tr('footer.rights')} · <a href={SOCIAL.source}>{tr('footer.source')}</a></span>
    <nav class="footer__links" aria-label="Social">
      <a href={SOCIAL.github} rel="me">github</a>
      <a href={SOCIAL.linkedin} rel="me">linkedin</a>
      <a href={`mailto:${SOCIAL.email}`}>{SOCIAL.email}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer a { color: var(--color-muted); }
  .footer a:hover { color: var(--color-text); }
</style>
