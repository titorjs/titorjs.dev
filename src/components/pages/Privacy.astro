---
import { getEntry, render } from 'astro:content';
import type { Locale } from '@/i18n/config';
import { localeTag, t } from '@/i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const entry = await getEntry('pages', `privacy.${locale}`);
if (!entry) throw new Error(`Missing privacy.${locale}.md`);
const { Content } = await render(entry);
const updated = entry.data.updated;
const updatedLabel = updated && new Intl.DateTimeFormat(localeTag(locale), { month: 'long', year: 'numeric' }).format(updated);
---

{
  updated && (
    <p class="label">
      {tr('now.updated')}: <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
    </p>
  )
}
<div class="prose"><Content /></div>
