---
import { getEntry, render } from 'astro:content';
import type { Locale } from '@/i18n/config';
import { localePath, t } from '@/i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const entry = await getEntry('pages', `about.${locale}`);
if (!entry) throw new Error(`Missing about.${locale}.md`);
const { Content } = await render(entry);
const [cvLabel, cvText] = tr('about.cv').split(': ');
---

<div class="prose"><Content /></div>
<p class="label about__cv">{cvLabel}: <a href={localePath(locale, 'cv')}>{cvText}</a></p>

<style>
  .about__cv {
    margin-top: var(--space-4);
  }
</style>
