---
import '@/styles/global.css';
import type { Locale } from '@/i18n/config';
import type { RouteId } from '@/i18n/routes';
import { localeTag, t } from '@/i18n/utils';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  locale: Locale;
  route: RouteId;
  title: string;
  description: string;
  alternates: { locale: Locale; path: string }[];
  image?: string;
  type?: 'website' | 'article';
}

const { locale, route, title, description, alternates, image, type } = Astro.props;
const tr = t(locale);
const fullTitle = route === 'home' ? `${title} · titorjs.dev` : `${title} · ${tr('site.title')}`;
---

<!doctype html>
<html lang={localeTag(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      /* Applies the stored theme before first paint so the page never flashes. */
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    <Seo locale={locale} title={fullTitle} description={description} alternates={alternates} image={image} type={type} />
  </head>
  <body>
    <a class="skip-link" href="#main">{tr('nav.skip')}</a>
    <Header locale={locale} current={route} alternates={alternates} />
    <main id="main" class="container main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .main {
    padding-block: var(--space-12) var(--space-16);
  }
</style>
